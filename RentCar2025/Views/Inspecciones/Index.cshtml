@model IEnumerable<RentCar.Models.Inspeccion>

@{
    ViewData["Title"] = "Inspecciones";
    Layout = "_Layout";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" rel="stylesheet" />
<link href="~/css/paginacion.css" rel="stylesheet" />

<style>
    :root {
        --primary-color: #6C4DFF;
        --hover-color: #5a3ee0;
        --header-bg: #fff4b1;
        --row-hover: #f9f9f9;
        --border-color: #eee;
        --text-color: #333;
        --secondary-text: #555;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f2fa;
    }

    .main-content {
        min-height: calc(100vh - 60px);
        padding: 20px;
    }

    .custom-container {
        background: white;
        border-radius: 20px;
        padding: 25px;
        margin: 20px auto;
        width: 95%;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        transform: translateY(20px);
        opacity: 0;
        animation: slideUp 0.6s ease-out 0.2s forwards;
    }

    @@keyframes slideUp {
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 25px;
        gap: 15px;
    }

        .table-header h2 {
            font-size: 26px;
            font-weight: 600;
            color: var(--text-color);
            margin: 0;
        }

    .btn-purple {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 20px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-purple:hover {
            background-color: var(--hover-color);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(92, 77, 255, 0.2);
            color: white;
            text-decoration: none;
        }

    .dropdown-container {
        position: relative;
        display: inline-block;
    }

    .btn-report {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 20px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

        .btn-report:hover {
            background-color: #218838;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(40, 167, 69, 0.2);
        }

    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: white;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        z-index: 1;
        border-radius: 8px;
        padding: 8px 0;
        margin-top: 5px;
    }

        .dropdown-menu a {
            color: #333;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            font-weight: 500;
            transition: background-color 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .dropdown-menu a:hover {
                background-color: #f1f1f1;
            }

    .dropdown-container:hover .dropdown-menu,
    .dropdown-container.show .dropdown-menu {
        display: block;
    }

    .input-search {
        position: relative;
        flex-grow: 1;
        max-width: 400px;
        min-width: 200px;
    }

        .input-search input {
            border: 1px solid #ddd;
            border-radius: 20px;
            padding: 10px 40px 10px 15px;
            outline: none;
            width: 100%;
            transition: all 0.3s ease;
            font-family: 'Poppins', sans-serif;
        }

            .input-search input:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 2px rgba(108, 77, 255, 0.2);
            }

        .input-search button {
            background: none;
            border: none;
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .input-search input:focus + button i {
            color: var(--primary-color);
        }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 10px;
        overflow: hidden;
        margin: 20px 0;
        table-layout: fixed;
    }

        .styled-table thead {
            background-color: var(--header-bg);
            color: var(--text-color);
        }

            .styled-table thead th {
                padding: 15px;
                text-align: left;
                font-size: 14px;
                font-weight: 600;
                position: relative;
                transition: background-color 0.3s ease;
            }

                .styled-table thead th:hover {
                    background-color: #ffe878;
                }

        .styled-table tbody tr {
            opacity: 0;
            transform: translateX(-10px);
            animation: fadeInRow 0.4s ease-out forwards;
        }

    @@keyframes fadeInRow {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .styled-table tbody tr:nth-child(1) { animation-delay: 0.3s; }
    .styled-table tbody tr:nth-child(2) { animation-delay: 0.4s; }
    .styled-table tbody tr:nth-child(3) { animation-delay: 0.5s; }
    .styled-table tbody tr:nth-child(4) { animation-delay: 0.6s; }
    .styled-table tbody tr:nth-child(5) { animation-delay: 0.7s; }
    .styled-table tbody tr:nth-child(n+6) { animation-delay: 0.8s; }

    .styled-table tbody td {
        padding: 15px;
        font-size: 14px;
        border-bottom: 1px solid var(--border-color);
        transition: background-color 0.3s ease;
        vertical-align: middle;
    }

    .styled-table tbody tr:hover {
        background-color: var(--row-hover);
    }

        .styled-table tbody tr:hover td {
            background-color: var(--row-hover);
        }

    .operations-cell {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .icon {
        font-size: 18px;
        color: var(--secondary-text);
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
    }

    .icon-edit:hover {
        color: #3498db;
        transform: scale(1.1);
    }

    .icon-details:hover {
        color: #2ecc71;
        transform: scale(1.1);
    }

    .icon-delete:hover {
        color: #e74c3c;
        transform: scale(1.1);
    }

    .table-footer {
        margin-top: 20px;
        text-align: right;
        font-size: 14px;
        color: var(--secondary-text);
        opacity: 0;
        animation: fadeIn 0.5s ease-out 0.8s forwards;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-active {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status-inactive {
        background-color: #ffebee;
        color: #c62828;
    }

    .gomas-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 8px;
        justify-items: center;
        align-items: center;
    }

    .goma-icon {
        font-size: 22px;
        color: var(--primary-color);
    }

    .styled-table th:nth-child(1), .styled-table td:nth-child(1) { width: 12%; text-align: center; } 
    .styled-table th:nth-child(2), .styled-table td:nth-child(2) { width: 12%; text-align: center; } 
    .styled-table th:nth-child(3), .styled-table td:nth-child(3) { width: 8%; text-align: center; }
    .styled-table th:nth-child(4), .styled-table td:nth-child(4) { width: 12%; text-align: center; } 
    .styled-table th:nth-child(5), .styled-table td:nth-child(5) { width: 8%; text-align: center; } 
    .styled-table th:nth-child(6), .styled-table td:nth-child(6) { width: 10%; text-align: center; } 
    .styled-table th:nth-child(7), .styled-table td:nth-child(7) { width: 8%; text-align: center; } 
    .styled-table th:nth-child(8), .styled-table td:nth-child(8) { width: 6%; text-align: center; }
    .styled-table th:nth-child(9), .styled-table td:nth-child(9) { width: 8%; text-align: center; } 
    .styled-table th:nth-child(10), .styled-table td:nth-child(10) { width: 10%; text-align: center; } 
    .styled-table th:nth-child(11), .styled-table td:nth-child(11) { width: 6%; text-align: center; }
    .styled-table th:nth-child(12), .styled-table td:nth-child(12) { width: 12%; text-align: center; } 

    .alert-container {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 1000;
        max-width: 350px;
        width: 100%;
    }

    .alert {
        padding: 18px 25px;
        margin-bottom: 15px;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        transform: translateX(120%);
        opacity: 0;
        animation: slideInRight 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
        transition: all 0.4s ease;
    }

    .alert-success {
        color: #0f5132;
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        border-left: 5px solid #0f5132;
    }

    .alert-error {
        color: #842029;
        background: linear-gradient(135deg, #f8d7da, #f5c2c7);
        border-left: 5px solid #842029;
    }

    .alert-warning {
        color: #664d03;
        background: linear-gradient(135deg, #fff3cd, #ffecb5);
        border-left: 5px solid #664d03;
    }

    .alert-info {
        color: #055160;
        background: linear-gradient(135deg, #cff4fc, #b6effb);
        border-left: 5px solid #055160;
    }

    .alert-icon {
        font-size: 24px;
        margin-right: 15px;
        flex-shrink: 0;
    }

    .alert-content {
        flex-grow: 1;
    }

    .alert-title {
        font-weight: 600;
        margin-bottom: 3px;
        font-size: 16px;
    }

    .alert-message {
        font-size: 14px;
        opacity: 0.9;
    }

    .close-btn {
        margin-left: 15px;
        cursor: pointer;
        font-size: 20px;
        opacity: 0.7;
        transition: all 0.3s ease;
        flex-shrink: 0;
        padding: 5px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
    }

        .close-btn:hover {
            opacity: 1;
            background-color: rgba(0, 0, 0, 0.1);
            transform: rotate(90deg);
        }

    .progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 4px;
        background-color: rgba(15, 81, 50, 0.3);
        width: 100%;
        transform-origin: left;
        transform: scaleX(1);
        animation: progressBar 5s linear forwards;
    }

    @@keyframes slideInRight {
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes progressBar {
        from {
            transform: scaleX(1);
        }

        to {
            transform: scaleX(0);
        }
    }

    .alert.hide {
        animation: slideOutRight 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
    }

    @@keyframes slideOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(120%);
            opacity: 0;
        }
    }

    @@media (max-width: 768px) {
        .table-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .input-search {
            width: 100%;
            max-width: 100%;
        }

        .styled-table {
            display: block;
            overflow-x: auto;
        }

        .alert-container {
            top: 70px;
            right: 10px;
            max-width: 280px;
        }

        .alert {
            padding: 15px 20px;
        }
    }
</style>

<div class="main-content">
    <div class="custom-container">
        <div class="table-header">
            <h2>Inspecciones</h2>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <a asp-action="Create" class="btn-purple">
                    <i class="bi bi-plus-lg"></i> REGISTRAR INSPECCIÓN
                </a>

                <div class="dropdown-container">
                    <button class="btn-report" id="report-dropdown-btn-inspecciones" type="button">
                        <i class="bi bi-file-earmark-pdf"></i> GENERAR REPORTE PDF
                    </button>
                    <div class="dropdown-menu" id="report-dropdown-menu-inspecciones">
                        <a href="@Url.Action("GeneratePdfReport", "Inspecciones", new { searchString = ViewData["SearchString"], download = true })" target="_blank">
                            <i class="bi bi-download"></i> Descargar PDF
                        </a>
                        <a href="@Url.Action("GeneratePdfReport", "Inspecciones", new { searchString = ViewData["SearchString"], download = false })" target="_blank">
                            <i class="bi bi-printer"></i> Imprimir PDF
                        </a>
                    </div>
                </div>

            </div>
            <form asp-controller="Inspecciones" asp-action="Index" method="get" class="input-search">
                <input type="search" name="searchString" placeholder="Buscar inspección..." value="@Context.Request.Query["searchString"]" />
                <button type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>

        <table class="styled-table">
            <thead>
                <tr>
                    <th>Vehículo</th>
                    <th>Cliente</th>
                    <th style="text-align:center;">Fecha</th>
                    <th style="text-align:center;">Empleado</th>
                    <th style="text-align:center;">Ralladuras</th>
                    <th style="text-align:center;">Combustible</th>
                    <th style="text-align:center;">Goma Resp.</th>
                    <th style="text-align:center;">Gato</th>
                    <th style="text-align:center;">Rot. Cristal</th>
                    <th style="text-align:center;">Estado Gomas</th>
                    <th style="text-align:center;">Estado</th>
                    <th style="text-align:center;">Operaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align:center;">@(item.Vehiculo?.Modelo?.Descripcion ?? item.Vehiculo?.Id.ToString() ?? "N/A")</td>
                        <td style="text-align:center;">@(item.Cliente?.Nombre ?? item.Cliente?.Id.ToString() ?? "N/A")</td>
                        <td style="text-align:center;">@item.Fecha.ToShortDateString()</td>
                        <td style="text-align:center;">@(item.Empleado?.Nombre ?? item.Empleado?.Id.ToString() ?? "N/A")</td>
                        <td style="text-align:center;">@(item.TieneRalladuras ? "Sí" : "No")</td>
                        <td style="text-align:center;">
                            @if (item.CantidadCombustible == "1/4")
                            {
                                <text>1/4</text>
                            }
                            else if (item.CantidadCombustible == "1/2")
                            {
                                <text>1/2</text>
                            }
                            else if (item.CantidadCombustible == "3/4")
                            {
                                <text>3/4</text>
                            }
                            else if (item.CantidadCombustible == "Lleno")
                            {
                                <text>Lleno</text>
                            }
                            else
                            {
                                <text>N/A</text>
                            }
                        </td>
                        <td style="text-align:center;">@(item.TieneGomaRespuesta ? "Sí" : "No")</td>
                        <td style="text-align:center;">@(item.TieneGato ? "Sí" : "No")</td>
                        <td style="text-align:center;">@(item.TieneRoturasCristal ? "Sí" : "No")</td>
                        <td style="text-align:center;">
                            <div class="gomas-container">
                                <i class="bi @(item.EstadoGomas == true ? "bi-check-square-fill" : "bi-square") goma-icon" title="Delantera Izquierda"></i>
                                <i class="bi @(item.EstadoGomas2 == true ? "bi-check-square-fill" : "bi-square") goma-icon" title="Delantera Derecha"></i>
                                <i class="bi @(item.EstadoGomas3 == true ? "bi-check-square-fill" : "bi-square") goma-icon" title="Trasera Izquierda"></i>
                                <i class="bi @(item.EstadoGomas4 == true ? "bi-check-square-fill" : "bi-square") goma-icon" title="Trasera Derecha"></i>
                            </div>
                        </td>
                        <td style="text-align:center;">
                            <span class="status-badge @(item.Estado ? "status-active" : "status-inactive")">
                                @(item.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td style="text-align:center;">
                            <div class="operations-cell">
                                <a asp-action="Edit" asp-route-id="@item.Id" title="Editar" class="icon icon-edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" title="Detalles" class="icon icon-details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" title="Eliminar" class="icon icon-delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-container">
            <div class="pagination-info">
                Mostrando página @ViewData["CurrentPage"] de @ViewData["TotalPages"] - @Model.Count() registros
            </div>

            <ul class="pagination">
                <li class="page-item @((int)ViewData["CurrentPage"] == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = (int)ViewData["CurrentPage"] - 1, searchString = ViewData["SearchString"] })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    int currentPage = (int)ViewData["CurrentPage"];
                    int totalPages = (int)ViewData["TotalPages"];
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);

                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = 1, searchString = ViewData["SearchString"] })">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, searchString = ViewData["SearchString"] })">@i</a>
                        </li>
                    }

                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = totalPages, searchString = ViewData["SearchString"] })">@totalPages</a>
                        </li>
                    }
                }

                <li class="page-item @((int)ViewData["CurrentPage"] == (int)ViewData["TotalPages"] ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = (int)ViewData["CurrentPage"] + 1, searchString = ViewData["SearchString"] })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>

        <div class="table-footer">
            <p>Total de inspecciones: @Model.Count()</p>
        </div>
    </div>
</div>

<div class="alert-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" id="successAlert">
            <i class="bi bi-check-circle-fill alert-icon"></i>
            <div class="alert-content">
                <div class="alert-title">¡Éxito!</div>
                <div class="alert-message">@TempData["SuccessMessage"]</div>
            </div>
            <span class="close-btn" onclick="dismissAlert(this.parentElement)">&times;</span>
            <div class="progress-bar"></div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error" id="errorAlert">
            <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
            <div class="alert-content">
                <div class="alert-title">Error</div>
                <div class="alert-message">@TempData["ErrorMessage"]</div>
            </div>
            <span class="close-btn" onclick="dismissAlert(this.parentElement)">&times;</span>
            <div class="progress-bar" style="background-color: rgba(132, 32, 41, 0.3);"></div>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning" id="warningAlert">
            <i class="bi bi-exclamation-circle-fill alert-icon"></i>
            <div class="alert-content">
                <div class="alert-title">Advertencia</div>
                <div class="alert-message">@TempData["WarningMessage"]</div>
            </div>
            <span class="close-btn" onclick="dismissAlert(this.parentElement)">&times;</span>
            <div class="progress-bar" style="background-color: rgba(102, 77, 3, 0.3);"></div>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info" id="infoAlert">
            <i class="bi bi-info-circle-fill alert-icon"></i>
            <div class="alert-content">
                <div class="alert-title">Información</div>
                <div class="alert-message">@TempData["InfoMessage"]</div>
            </div>
            <span class="close-btn" onclick="dismissAlert(this.parentElement)">&times;</span>
            <div class="progress-bar" style="background-color: rgba(5, 81, 96, 0.3);"></div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function dismissAlert(alert) {
            alert.classList.add('hide');
            setTimeout(() => {
                alert.remove();
            }, 600);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const container = document.querySelector('.custom-container');
            if (container) {
                container.style.animation = 'slideUp 0.6s ease-out 0.2s forwards';
            }

            const rows = document.querySelectorAll('.styled-table tbody tr');
            rows.forEach((row, index) => {
                row.style.animationDelay = `${0.3 + (index * 0.1)}s`;
                row.style.animation = 'fadeInRow 0.4s ease-out forwards';
            });

            const footer = document.querySelector('.table-footer');
            if (footer) {
                footer.style.animation = 'fadeIn 0.5s ease-out 0.8s forwards';
            }

            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    dismissAlert(alert);
                }, 5000);
            });

            const dropdownBtnInspecciones = document.getElementById('report-dropdown-btn-inspecciones');
            const dropdownMenuInspecciones = document.getElementById('report-dropdown-menu-inspecciones');

            dropdownBtnInspecciones.addEventListener('click', function() {
                const isVisible = dropdownMenuInspecciones.style.display === 'block';
                dropdownMenuInspecciones.style.display = isVisible ? 'none' : 'block';
            });

            window.addEventListener('click', function(e) {
                if (!dropdownBtnInspecciones.contains(e.target) && !dropdownMenuInspecciones.contains(e.target)) {
                    dropdownMenuInspecciones.style.display = 'none';
                }
            });
        });
    </script>
}