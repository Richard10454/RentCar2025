<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentCar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentCar2025.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/Navbar.css" rel="stylesheet">
   
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" class="car-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M5 16V14H19V16H5ZM5 10V8L6.5 5H17.5L19 8V10H5ZM5 11H19V19H5V11ZM7.5 15C7.5 15.8284 8.17157 16.5 9 16.5C9.82843 16.5 10.5 15.8284 10.5 15C10.5 14.1716 9.82843 13.5 9 13.5C8.17157 13.5 7.5 14.1716 7.5 15ZM13.5 15C13.5 15.8284 14.1716 16.5 15 16.5C15.8284 16.5 16.5 15.8284 16.5 15C16.5 14.1716 15.8284 13.5 15 13.5C14.1716 13.5 13.5 14.1716 13.5 15ZM6 10V8.5H7V10H6ZM17 10V8.5H18V10H17Z" />
                    </svg>
                    <span>RentCar</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Clientes" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Clientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehiculos" asp-action="Index">
                                <i class="bi bi-car-front me-1"></i> Vehículos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rentas" asp-action="Index">
                                <i class="bi bi-receipt me-1"></i> Rentas
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="managementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-clipboard-data me-1"></i> Gestión
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="managementDropdown">
                                <li><a class="dropdown-item" asp-controller="Inspecciones" asp-action="Index"><i class="bi bi-clipboard-check"></i> Inspecciones</a></li>
                                <li><a class="dropdown-item" asp-controller="Empleados" asp-action="Index"><i class="bi bi-person-badge"></i> Empleados</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="ReporteRenta"><i class="bi bi-graph-up"></i> Reportes</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="catalogosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-collection me-1"></i> Catálogos
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="catalogosDropdown">
                                <li><a class="dropdown-item" asp-controller="Marcas" asp-action="Index"><i class="bi bi-tag"></i> Marcas</a></li>
                                <li><a class="dropdown-item" asp-controller="Modelos" asp-action="Index"><i class="bi bi-tags"></i> Modelos</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="TipoCombustibles" asp-action="Index"><i class="bi bi-fuel-pump"></i> Combustibles</a></li>
                                <li><a class="dropdown-item" asp-controller="TipoVehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Tipos de Vehículo</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center action-buttons">
                        @if (Context.Session.GetString("UserName") != null)
                        {
                            var userName = Context.Session.GetString("UserName");
                            var initial = userName.Substring(0, 1).ToUpper();

                            <a class="nav-link action-btn-secondary me-3" asp-controller="Home" asp-action="Nosotros">
                                <i class="bi bi-info-circle me-1"></i> Nosotros
                            </a>

                            <div class="dropdown">
                                <a class="nav-link p-0" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar position-relative">
                                        @initial
                                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-2 border-white rounded-circle">
                                            <span class="visually-hidden">Usuario en línea</span>
                                        </span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end user-dropdown" aria-labelledby="userDropdown">
                                    <li class="user-dropdown-header">
                                        <div class="d-flex align-items-center">
                                            <div class="user-avatar me-2 bg-primary">@initial</div>
                                            <div>
                                                <div class="fw-bold">@userName</div>
                                                <small class="text-muted">Administrador</small>
                                            </div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Configuración</a></li>
                                    <li>
                                        <a class="dropdown-item position-relative" href="#">
                                            <i class="bi bi-bell me-2"></i>Notificaciones
                                            <span class="notification-badge">3</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Usuarios" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                    <li class="user-dropdown-footer">
                                        <small>Último acceso: hoy a las @DateTime.Now.ToString("hh:mm tt")</small>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link action-btn action-btn-secondary me-2" asp-controller="Home" asp-action="Nosotros">
                                <i class="bi bi-info-circle me-1"></i> Nosotros
                            </a>
                            <a class="nav-link action-btn me-2" asp-controller="Usuarios" asp-action="Create">
                                <i class="bi bi-person-plus me-1"></i> Registrarse
                            </a>
                            <a class="nav-link action-btn" asp-controller="Usuarios" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container-fluid px-4">
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2025 RentCar Pro - <a asp-controller="Home" asp-action="Privacy">Política de Privacidad</a>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="#" class="text-decoration-none me-3">Términos de Servicio</a>
                    <a href="#" class="text-decoration-none">Soporte</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
            }
        });

        document.querySelectorAll('.nav-link').forEach(link => {
            if (link.href === window.location.href) {
                link.classList.add('active');
                let parentDropdown = link.closest('.dropdown-menu');
                if (parentDropdown) {
                    let dropdownToggle = document.querySelector('[aria-labelledby="' + parentDropdown.getAttribute('aria-labelledby') + '"]');
                    if (dropdownToggle) {
                        dropdownToggle.classList.add('active');
                    }
                }
            }
        });

        document.querySelectorAll('.dropdown').forEach(dropdown => {
            dropdown.addEventListener('show.bs.dropdown', function () {
                let dropdownMenu = this.querySelector('.dropdown-menu');
                dropdownMenu.style.opacity = '0';
                dropdownMenu.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    dropdownMenu.style.opacity = '1';
                    dropdownMenu.style.transform = 'translateY(0)';
                }, 10);
            });
        });

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(element => {
            new bootstrap.Tooltip(element);
        });

        const carIcon = document.querySelector('.car-icon');
        if (carIcon) {
            carIcon.addEventListener('mouseenter', () => {
                carIcon.style.transform = 'rotate(15deg)';
            });
            carIcon.addEventListener('mouseleave', () => {
                carIcon.style.transform = 'rotate(0)';
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>