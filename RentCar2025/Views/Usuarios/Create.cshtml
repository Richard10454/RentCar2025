@model RentCar2025.Migrations.Models.Usuarios

@{
    ViewData["Title"] = "Registrar Nuevo Usuario";
    Layout = "_LayoutLogin";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/Index.css" />
<link rel="stylesheet" href="~/css/Users.css" />

<div class="container-xxl py-5 px-4">
    <div class="form-header animate__animated animate__fadeIn text-center mb-5">
        <h1 class="display-5 fw-bold mb-3">Registrar <span class="text-highlight">Nuevo Usuario</span></h1>
        <div class="divider mx-auto my-3"></div>
        <p class="lead mb-4">Complete el formulario para agregar un nuevo usuario al sistema</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card p-4 p-lg-5 animate__animated animate__fadeIn">
                <form asp-action="Create" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Nombre" class="form-label">
                                    <i class="bi bi-person-fill me-2"></i>Nombre Completo
                                </label>
                                <input asp-for="Nombre" class="form-control form-control-lg" required />
                                <span asp-validation-for="Nombre" class="invalid-feedback">Por favor ingrese el nombre</span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="correo" class="form-label">
                                    <i class="bi bi-envelope-fill me-2"></i>Correo Electrónico
                                </label>
                                <input asp-for="correo" type="email" class="form-control form-control-lg" required />
                                <span asp-validation-for="correo" class="invalid-feedback">Por favor ingrese un correo válido</span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Contrasena" class="form-label">
                                    <i class="bi bi-lock-fill me-2"></i>Contraseña
                                </label>
                                <div class="input-group">
                                    <input asp-for="Contrasena" type="password" class="form-control form-control-lg" required
                                           pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$" />
                                    <button class="btn btn-outline-secondary toggle-password" type="button">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Contrasena" class="invalid-feedback">
                                    La contraseña debe tener al menos 8 caracteres, una mayúscula, una minúscula y un número
                                </span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Telefono" class="form-label">
                                    <i class="bi bi-telephone-fill me-2"></i>Teléfono
                                </label>
                                <input asp-for="Telefono" class="form-control form-control-lg" />
                                <span asp-validation-for="Telefono" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="FechaNacimiento" class="form-label">
                                    <i class="bi bi-calendar-event me-2"></i>Fecha de Nacimiento
                                </label>
                                <input asp-for="FechaNacimiento" type="date" class="form-control form-control-lg" />
                                <span asp-validation-for="FechaNacimiento" class="invalid-feedback"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Genero" class="form-label">
                                    <i class="bi bi-gender-ambiguous me-2"></i>Género
                                </label>
                                <select asp-for="Genero" class="form-select form-select-lg">
                                    <option value="">Seleccione...</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Femenino">Femenino</option>
                                    <option value="Otro">Otro</option>
                                </select>
                                <span asp-validation-for="Genero" class="invalid-feedback"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Nacionalidad" class="form-label">
                                    <i class="bi bi-globe-americas me-2"></i>Nacionalidad
                                </label>
                                <input asp-for="Nacionalidad" class="form-control form-control-lg" />
                                <span asp-validation-for="Nacionalidad" class="invalid-feedback"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="EstadoCivil" class="form-label">
                                    <i class="bi bi-heart-fill me-2"></i>Estado Civil
                                </label>
                                <select asp-for="EstadoCivil" class="form-select form-select-lg">
                                    <option value="">Seleccione...</option>
                                    <option value="Soltero">Soltero</option>
                                    <option value="Casado">Casado</option>
                                    <option value="Divorciado">Divorciado</option>
                                    <option value="Viudo">Viudo</option>
                                </select>
                                <span asp-validation-for="EstadoCivil" class="invalid-feedback"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Login" class="btn btn-outline-secondary btn-lg px-4 me-md-2">
                            <i class="bi bi-arrow-left me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg px-4">
                            <i class="bi bi-save-fill me-2"></i>Guardar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function() {
                const input = this.previousElementSibling;
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);
                this.querySelector('i').classList.toggle('bi-eye-fill');
                this.querySelector('i').classList.toggle('bi-eye-slash-fill');
            });
        });

        (function () {
            'use strict'

            const forms = document.querySelectorAll('.needs-validation')

            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }

                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}